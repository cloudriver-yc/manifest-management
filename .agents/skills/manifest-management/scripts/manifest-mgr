#!/usr/bin/env bash
set -e

# Resolve script directory and skill root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH}"

# Auto-detect workspace root if not already set
if [ -z "${WORKSPACE_ROOT}" ]; then
  DIR="$(pwd)"
  while [ "$DIR" != "/" ]; do
    if [ -d "$DIR/relations" ] || [ -f "$DIR/GEMINI.md" ]; then
      export WORKSPACE_ROOT="$DIR"
      break
    fi
    DIR="$(dirname "$DIR")"
  done
fi

python3 -m py_engine.cli "$@"
